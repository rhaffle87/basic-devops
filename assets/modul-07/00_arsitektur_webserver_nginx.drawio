<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Arsitektur-Nginx-Modul-7" id="nginx-arch-modul-7">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 18px;&quot;&gt;Arsitektur Web Server Nginx &amp;amp; Siklus Penanganan HTTP Request (Modul 7)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;Integrasi Host Windows 10/11 &amp;bull; Lingkungan Virtualisasi WSL2 Ubuntu 22.04 LTS &amp;bull; Event-Driven Nginx Engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="55" as="geometry" />
        </mxCell>

        <!-- CONTAINER 1: Host Windows (Client Machine) -->
        <mxCell id="c_windows" value="Host Windows 10/11 (Client OS)" style="swimlane;startSize=36;rounded=1;arcSize=8;fillColor=#f0f6ff;strokeColor=#0078d7;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#005a9e;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="310" height="550" as="geometry" />
        </mxCell>

        <!-- Windows Logo -->
        <mxCell id="icon_win" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/windows8/windows8-original.svg;" vertex="1" parent="c_windows">
          <mxGeometry x="260" y="5" width="26" height="26" as="geometry" />
        </mxCell>

        <!-- Client Browser Component -->
        <mxCell id="c_browser" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=2;" vertex="1" parent="c_windows">
          <mxGeometry x="20" y="60" width="270" height="460" as="geometry" />
        </mxCell>

        <!-- Browser Header Bar -->
        <mxCell id="chrome_bar" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;" vertex="1" parent="c_browser">
          <mxGeometry x="10" y="10" width="250" height="75" as="geometry" />
        </mxCell>

        <!-- Chrome Icon -->
        <mxCell id="icon_chrome" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/chrome/chrome-original.svg;" vertex="1" parent="chrome_bar">
          <mxGeometry x="10" y="8" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- Browser Tab Title -->
        <mxCell id="browser_tab" value="&lt;b&gt;Google Chrome&lt;/b&gt; &lt;span style=&quot;color:#64748b;&quot;&gt;&amp;bull; Portofolio Web&lt;/span&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="chrome_bar">
          <mxGeometry x="40" y="6" width="200" height="26" as="geometry" />
        </mxCell>

        <!-- Address Bar URL -->
        <mxCell id="browser_url" value="&lt;font color=&quot;#16a34a&quot;&gt;🔒 http://&lt;/font&gt;&lt;b&gt;localhost:80&lt;/b&gt;/index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;fontColor=#0f172a;" vertex="1" parent="chrome_bar">
          <mxGeometry x="10" y="38" width="230" height="28" as="geometry" />
        </mxCell>

        <!-- Web Page View Rendering -->
        <mxCell id="web_view" value="&lt;div style=&quot;text-align: center; padding: 10px;&quot;&gt;&lt;div style=&quot;background:#1e3a8a; color:#ffffff; padding:12px; border-radius:6px; font-weight:bold; font-size:12px;&quot;&gt;Website Portofolio Praktikan&lt;br&gt;&lt;span style=&quot;font-size:10px; font-weight:normal; color:#93c5fd;&quot;&gt;Dilayani oleh Nginx Linux&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:15px; padding:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; font-size:11px; text-align:left; color:#334155;&quot;&gt;&lt;b&gt;Rendering Status:&lt;/b&gt;&lt;br&gt;&amp;bull; HTTP 200 OK&lt;br&gt;&amp;bull; HTML, CSS, Assets loaded&lt;br&gt;&amp;bull; Fast &amp;amp; Non-blocking&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=center;verticalAlign=top;" vertex="1" parent="c_browser">
          <mxGeometry x="10" y="100" width="250" height="220" as="geometry" />
        </mxCell>

        <!-- Client Network Socket Interface -->
        <mxCell id="node_client" value="&lt;b&gt;Klien HTTP (OS Socket)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;Winsock TCP Stack (Host)&lt;br&gt;Loopback adapter: 127.0.0.1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;align=center;fontSize=11;" vertex="1" parent="c_browser">
          <mxGeometry x="15" y="345" width="240" height="95" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: WSL2 Ubuntu Environment -->
        <mxCell id="c_wsl" value="Windows Subsystem for Linux (WSL2) &amp;mdash; Ubuntu 22.04 LTS Server" style="swimlane;startSize=36;rounded=1;arcSize=8;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#9a3412;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="95" width="720" height="550" as="geometry" />
        </mxCell>

        <!-- Ubuntu Logo -->
        <mxCell id="icon_ubuntu" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/ubuntu/ubuntu-plain.svg;" vertex="1" parent="c_wsl">
          <mxGeometry x="645" y="5" width="26" height="26" as="geometry" />
        </mxCell>
        <!-- Linux Tux Logo -->
        <mxCell id="icon_linux" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg;" vertex="1" parent="c_wsl">
          <mxGeometry x="678" y="5" width="24" height="26" as="geometry" />
        </mxCell>

        <!-- SUB-CONTAINER 2.1: Nginx Service -->
        <mxCell id="c_nginx" value="Layanan Web Server Nginx (systemctl status nginx)" style="swimlane;startSize=32;rounded=1;arcSize=6;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#166534;html=1;" vertex="1" parent="c_wsl">
          <mxGeometry x="25" y="55" width="670" height="275" as="geometry" />
        </mxCell>

        <!-- Nginx Logo -->
        <mxCell id="icon_nginx" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nginx/nginx-original.svg;" vertex="1" parent="c_nginx">
          <mxGeometry x="625" y="4" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- Nginx Master Process Node -->
        <mxCell id="node_master" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Nginx Master Process&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#15803d;&quot;&gt;User: &lt;b&gt;root&lt;/b&gt; | Privileged Daemon | PID 1240&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;&amp;bull; Membaca &amp;amp; memvalidasi konfigurasi &lt;i&gt;/etc/nginx/sites-available/default&lt;/i&gt;&lt;br&gt;&amp;bull; Mengelola bind socket TCP port 80 dan mengendalikan siklus hidup worker&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="c_nginx">
          <mxGeometry x="25" y="45" width="620" height="80" as="geometry" />
        </mxCell>

        <!-- Nginx Worker Process Node -->
        <mxCell id="node_worker" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Nginx Worker Process (Event-Driven Engine)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#15803d;&quot;&gt;User: &lt;b&gt;www-data&lt;/b&gt; | Non-blocking Asynchronous | PID 1241&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;&amp;bull; Menerima koneksi HTTP dari soket port 80 secara non-blocking&lt;br&gt;&amp;bull; Menangani ribuan request simultan dengan mekanisme epoll/event-loop&lt;br&gt;&amp;bull; Membaca berkas statis dari storage dan mengirim respons ke browser&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#15803d;strokeWidth=2;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="c_nginx">
          <mxGeometry x="25" y="155" width="620" height="95" as="geometry" />
        </mxCell>

        <!-- SUB-CONTAINER 2.2: Filesystem Storage -->
        <mxCell id="c_storage" value="Linux Filesystem &amp;mdash; Web Document Root (/var/www/html/)" style="swimlane;startSize=32;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#334155;html=1;" vertex="1" parent="c_wsl">
          <mxGeometry x="25" y="350" width="670" height="175" as="geometry" />
        </mxCell>

        <!-- HTML5 Logo -->
        <mxCell id="icon_html" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg;" vertex="1" parent="c_storage">
          <mxGeometry x="625" y="4" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- Storage Directory Structure & Files -->
        <mxCell id="node_storage" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Folder Proyek: /var/www/html/Portfolio-responsive/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;File Owner: &lt;b&gt;root:root&lt;/b&gt; | Hak Akses: &lt;b&gt;755 (rwxr-xr-x)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;table style=&quot;width:100%; margin-top:6px; font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td&gt;📄 &lt;b&gt;index.html&lt;/b&gt; (Dokumen utama)&lt;/td&gt;&lt;td&gt;🎨 &lt;b&gt;css/style.css&lt;/b&gt; (Styling)&lt;/td&gt;&lt;td&gt;⚡ &lt;b&gt;js/script.js&lt;/b&gt; (Interaktif)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;align=left;spacingLeft=15;fontSize=11;" vertex="1" parent="c_storage">
          <mxGeometry x="25" y="45" width="620" height="105" as="geometry" />
        </mxCell>

        <!-- CONNECTIONS & EDGES -->

        <!-- 1. HTTP Request (Chrome -> Nginx Worker) -->
        <mxCell id="edge_req" value="&lt;b style=&quot;font-size:12px; color:#1d4ed8;&quot;&gt;1. HTTP GET /index.html&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#1e40af;&quot;&gt;Port 80 TCP (Koneksi Klien)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=3;fontSize=11;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_client" target="node_worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Master Supervises Worker -->
        <mxCell id="edge_supervise" value="&lt;span style=&quot;font-size:10px; color:#15803d;&quot;&gt;2. IPC Signal: Spawn Worker, Fork &amp;amp; Pass Socket&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c_nginx" source="node_master" target="node_worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Worker Reads Storage -->
        <mxCell id="edge_disk_read" value="&lt;b style=&quot;font-size:11px; color:#b45309;&quot;&gt;3. Read Static Files (sendfile syscall)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;fontSize=10;fontStyle=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="c_wsl" source="node_worker" target="node_storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. Storage returns Data Payload -->
        <mxCell id="edge_disk_ret" value="&lt;span style=&quot;font-size:10px; color:#047857;&quot;&gt;4. Kernel Stream / Data Binary HTML Payload&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;fontSize=10;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="c_wsl" source="node_storage" target="node_worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. HTTP Response (Nginx Worker -> Chrome) -->
        <mxCell id="edge_resp" value="&lt;b style=&quot;font-size:12px; color:#15803d;&quot;&gt;5. HTTP 200 OK (text/html)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#166534;&quot;&gt;Body Payload Website Portofolio&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=3;fontSize=11;fontStyle=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="node_worker" target="node_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
